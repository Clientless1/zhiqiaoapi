map $http_upgrade $zhiqiao_upgrade_connection {
    default upgrade;
    '' close;
}

server {
    listen 80 default_server;
    server_name 111.228.31.204;
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 308 https://zhiqiaoapi.fun$request_uri;
    }
}

server {
    listen 80;
    server_name zhiqiaoapi.fun api.zhiqiaoapi.fun;
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name zhiqiaoapi.fun api.zhiqiaoapi.fun;
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/zhiqiaoapi.fun/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zhiqiaoapi.fun/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ZhiqiaoTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    client_max_body_size 64m;
    access_log /var/log/nginx/zhiqiao-direct.access.log;
    error_log /var/log/nginx/zhiqiao-direct.error.log;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $zhiqiao_upgrade_connection;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_connect_timeout 15s;
        proxy_read_timeout 1200s;
        proxy_send_timeout 1200s;
        send_timeout 1200s;
    }
}
