# Forward WebSocket upgrade headers only when the client asks for a protocol
# upgrade (e.g. /v1/realtime); ordinary HTTP does not need a hop-by-hop header.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' '';
}

server {
    listen 80;
    server_name _;

    # Required for Docker overlay2: sendfile can return empty responses
    # when the file sits on a different filesystem layer.
    sendfile off;

    client_max_body_size 64m;

    root /usr/share/nginx/html;
    index index.html;

    # Vite puts the content hash in these filenames. Cache them at the edge
    # and in browsers without caching HTML, auth responses or model traffic.
    # gzip_static serves build-time compressed files; dynamic gzip stays off
    # so this never buffers SSE or compresses personalized API responses.
    location ~ "^/assets/.+-[A-Za-z0-9_-]{8,}\.(?:js|css)$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
        gzip_static on;
        gzip_vary on;
        try_files $uri =404;
    }

    location ~ ^/(oauth/(?:github|google)/callback|api|apps|widget|v1|anthropic|readyz|livez|install(?:\.ps1)?)(/|$) {
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Keep streaming APIs responsive and allow long-running model/image requests.
        proxy_buffering off;
        proxy_request_buffering off;
        add_header X-Accel-Buffering no always;
        proxy_connect_timeout 60s;
        proxy_read_timeout 1200s;
        proxy_send_timeout 1200s;
        send_timeout 1200s;

        # Use variable to defer DNS resolution so nginx doesn't crash if backend isn't ready at startup
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $backend_upstream ${API_UPSTREAM};
        proxy_pass $backend_upstream;
    }

    # Revalidate SPA documents so an existing tab picks up branding updates.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        expires -1;
    }

    # Older documents may still request the previous favicon URLs.
    location ~ ^/(favicon\.(svg|png|ico)|apple-touch-icon\.png)$ {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        expires -1;
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
